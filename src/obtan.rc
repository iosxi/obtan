#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "obtan.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "obtan.manifest"

IDD_APP DIALOGEX 0, 0, 360, 336
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "アプリの登録"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "URL:", -1, 10, 10, 70, 10
    EDITTEXT        IDC_URL, 82, 8, 214, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "調べる", IDC_PROBE_BTN, 300, 7, 50, 15
    LTEXT           "GitHub などのリポジトリ、Firefox アドオン、ダウンロードのリンクがあるページ", IDC_HINT1, 82, 24, 268, 10

    LTEXT           "名前:", -1, 10, 41, 70, 10
    EDITTEXT        IDC_NAME, 82, 39, 120, 13, ES_AUTOHSCROLL
    LTEXT           "取得元:", -1, 210, 41, 30, 10
    COMBOBOX        IDC_KIND, 242, 39, 108, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "ファイル名の条件:", -1, 10, 60, 70, 10
    EDITTEXT        IDC_FILTER, 82, 58, 268, 13, ES_AUTOHSCROLL
    LTEXT           "正規表現（大文字小文字は区別しない）。空欄なら Windows 向けらしいファイルを自動で選ぶ。Web ページでは空欄だと .exe .msi .zip .xpi などへのリンクが対象。例: x64.*\\.zip$", IDC_HINT2, 82, 73, 268, 26

    LTEXT           "版の取り出し:", -1, 10, 104, 70, 10
    EDITTEXT        IDC_VERRX, 82, 102, 268, 13, ES_AUTOHSCROLL
    LTEXT           "正規表現。( ) で囲んだ部分を版とする。空欄なら自動（リリースはタグ名、Web ページはファイル名から）。例: -v(\\d+)\\.zip", IDC_HINT3, 82, 117, 268, 18

    AUTOCHECKBOX    "プレリリースも対象にする", IDC_PRE, 82, 138, 200, 11

    LTEXT           "保存先フォルダ:", -1, 10, 157, 70, 10
    EDITTEXT        IDC_DEST, 82, 155, 214, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "参照...", IDC_DEST_BROWSE, 300, 154, 50, 15
    LTEXT           "", IDC_DEST_HINT, 82, 170, 268, 10, SS_PATHELLIPSIS

    LTEXT           "取得済みの版:", -1, 10, 189, 70, 10
    EDITTEXT        IDC_INSTALLED, 82, 187, 100, 13, ES_AUTOHSCROLL
    LTEXT           "ダウンロードすると自動で入る。手で直してもよい", IDC_HINT4, 188, 189, 162, 10

    GROUPBOX        "調べた結果", -1, 10, 206, 340, 102
    EDITTEXT        IDC_PROBE_OUT, 16, 218, 328, 84, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL

    DEFPUSHBUTTON   "OK", IDOK, 236, 315, 54, 15
    PUSHBUTTON      "キャンセル", IDCANCEL, 296, 315, 54, 15
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 124
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "設定"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "既定の保存先:", -1, 10, 10, 280, 10
    EDITTEXT        IDC_DEFDIR, 10, 22, 226, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "参照...", IDC_DEFDIR_BROWSE, 240, 21, 50, 15
    LTEXT           "保存先フォルダを指定していないアプリは、この下の「名前」のフォルダに保存する。", IDC_HINT5, 10, 38, 280, 10

    LTEXT           "GitHub トークン（任意）:", -1, 10, 58, 280, 10
    EDITTEXT        IDC_TOKEN, 10, 70, 280, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "「確認」で使う GitHub の API は 1 時間 60 回まで。トークンを入れると 5000 回まで増える。", IDC_HINT6, 10, 85, 280, 10

    DEFPUSHBUTTON   "OK", IDOK, 176, 103, 54, 15
    PUSHBUTTON      "キャンセル", IDCANCEL, 236, 103, 54, 15
END

IDD_NOTES DIALOGEX 0, 0, 380, 300
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "リリースノート"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "", IDC_NOTES_HEAD, 7, 7, 366, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    EDITTEXT        IDC_NOTES_TEXT, 7, 21, 366, 251, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "ブラウザで開く", IDC_NOTES_OPEN, 7, 278, 70, 15
    DEFPUSHBUTTON   "閉じる", IDCANCEL, 319, 278, 54, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 7,0,0,0
PRODUCTVERSION 7,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "FileDescription", "obtan - アプリの新しい版を見張ってダウンロードする"
            VALUE "ProductName", "obtan"
            VALUE "FileVersion", "7"
            VALUE "ProductVersion", "7"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
